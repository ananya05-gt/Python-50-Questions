   "source": [
    "print(\"Prime numbers between 100 and 200 are:\")\n",
    "\n",
    "for num in range(100, 201):\n",
    "    if num > 1:\n",
    "        for i in range(2, num):\n",
    "            if num % i == 0:\n",
    "                break\n",
    "        else:\n",
    "            print(num, end=\", \")"
   ]
