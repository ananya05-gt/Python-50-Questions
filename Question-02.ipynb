   "source": [
    "def find_largest(numbers):\n",
    "    largest = numbers[0]\n",
    "\n",
    "    for num in numbers:\n",
    "        if num > largest:\n",
    "            largest = num\n",
    "\n",
    "    return largest\n",
    "\n",
    "\n",
    "my_list = [10, 25, 8, 45, 12, 30]\n",
    "\n",
    "result = find_largest(my_list)\n",
    "\n",
    "print(\"List:\", my_list)\n",
    "print(\"Largest element:\", result)"
   ]
  },
