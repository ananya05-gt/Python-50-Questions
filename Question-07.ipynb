   "source": [
    "def count_vowels(text):\n",
    "    vowels = \"aeiou\"\n",
    "    count = 0\n",
    "\n",
    "    for char in text:\n",
    "        if char.lower() in vowels:\n",
    "            count += 1\n",
    "\n",
    "    return count\n",
    "\n",
    "\n",
    "word = input(\"Enter a string: \")\n",
    "\n",
    "result = count_vowels(word)\n",
    "\n",
    "print(\"Number of vowels:\", result)"
   ]
  },
